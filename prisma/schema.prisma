// prisma/schema.prisma
// AtomQuest Hackathon 1.0 — Goal Setting & Tracking Portal
// Every field maps to a PS requirement. Do not remove any field.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USERS & ORG ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String    // bcrypt, min 10 rounds
  role            Role      @default(EMPLOYEE)
  department      String?
  designation     String?
  employeeCode    String?   @unique
  isActive        Boolean   @default(true)
  avatarUrl       String?

  managerId       String?
  manager         User?     @relation("Reports", fields: [managerId], references: [id])
  reports         User[]    @relation("Reports")

  skipManagerId   String?
  skipManager     User?     @relation("SkipLevel", fields: [skipManagerId], references: [id])
  skipReports     User[]    @relation("SkipLevel")

  ownedGoals      Goal[]    @relation("GoalOwner")
  approvedGoals   Goal[]    @relation("GoalApprover")
  sharedGoals     Goal[]    @relation("SharedGoalRecipients")
  checkins        Checkin[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  escalationLogs  EscalationLog[]
  comments        GoalComment[]

  feedbackGiven       PeerFeedback[] @relation("FeedbackGiver")
  feedbackReceived    PeerFeedback[] @relation("FeedbackReceiver")
  reviewResponses     ReviewResponse[] @relation("ReviewResponder")
  reviewSubject       ReviewResponse[] @relation("ReviewSubject")
  enpsResponses       ENPSResponse[]
  managedMeetings     OneOnOneMeeting[] @relation("MeetingManager")
  employeeMeetings    OneOnOneMeeting[] @relation("MeetingEmployee")

  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([managerId])
  @@index([department])
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  HR
}

// ─── CYCLES ──────────────────────────────────────────────────

model Cycle {
  id               String      @id @default(cuid())
  name             String
  fiscalYear       String
  isActive         Boolean     @default(false)
  createdBy        String

  goalSettingOpen  DateTime
  goalSettingClose DateTime
  q1Open           DateTime
  q1Close          DateTime
  q2Open           DateTime
  q2Close          DateTime
  q3Open           DateTime
  q3Close          DateTime
  q4Open           DateTime
  q4Close          DateTime

  goals            Goal[]
  checkins         Checkin[]
  escalationRules  EscalationRule[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─── GOALS ───────────────────────────────────────────────────

model Goal {
  id              String      @id @default(cuid())
  title           String
  description     String?
  thrustArea      String

  uomType         UoMType
  uomUnit         String?
  target          Float?
  targetDate      DateTime?

  weightage       Float       // 10-100, per-employee sum must = 100 per cycle

  status          GoalStatus  @default(DRAFT)
  isLocked        Boolean     @default(false)
  lockedAt        DateTime?

  isShared        Boolean     @default(false)
  primaryOwnerId  String?
  sharedWith      User[]      @relation("SharedGoalRecipients")

  ownerId         String
  owner           User        @relation("GoalOwner", fields: [ownerId], references: [id])
  approverId      String?
  approver        User?       @relation("GoalApprover", fields: [approverId], references: [id])
  cycleId         String
  cycle           Cycle       @relation(fields: [cycleId], references: [id])

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  returnedAt      DateTime?
  returnReason    String?
  reworkCount     Int         @default(0)

  latestScore     Float?
  latestStatus    ProgressStatus @default(NOT_STARTED)

  // Cascading hierarchy
  goalLevel       GoalLevel   @default(INDIVIDUAL)
  parentGoalId    String?
  parentGoal      Goal?       @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  childGoals      Goal[]      @relation("GoalHierarchy")

  cancelledAt     DateTime?
  cancelReason    String?

  checkins        Checkin[]
  auditLogs       AuditLog[]
  comments        GoalComment[]
  milestones      Milestone[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([ownerId, cycleId])
  @@index([approverId])
  @@index([status])
  @@index([cycleId, status])   // analytics + action-items: WHERE cycleId=X AND status IN [...]
}

enum GoalLevel {
  COMPANY
  DEPARTMENT
  INDIVIDUAL
}

enum UoMType {
  NUMERIC_MIN   // Higher is better: score = actual / target
  NUMERIC_MAX   // Lower is better: score = target / actual
  TIMELINE      // Date completion
  ZERO          // Zero = 100%
  PERCENTAGE    // 0-100 scale
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  LOCKED
  CANCELLED
}

enum ProgressStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  COMPLETED
  OVERDUE
}

// ─── CHECK-INS ───────────────────────────────────────────────

model Checkin {
  id                String          @id @default(cuid())
  quarter           Quarter
  goalId            String
  goal              Goal            @relation(fields: [goalId], references: [id])
  cycleId           String
  cycle             Cycle           @relation(fields: [cycleId], references: [id])
  employeeId        String
  employee          User            @relation(fields: [employeeId], references: [id])

  actualValue       Float?
  actualDate        DateTime?
  progressStatus    ProgressStatus  @default(NOT_STARTED)
  employeeNote      String?
  selfRating        Int?            // 1-5 stars (employee self-assessment)
  whatWentWell      String?
  blockers          String?

  progressScore     Float?          // 0.0 to 1.0+
  scorePercentage   Float?          // progressScore * 100

  managerCheckedIn  Boolean         @default(false)
  managerComment    String?
  managerRating     Int?            // 1-5
  checkedInBy       String?
  checkedInAt       DateTime?

  submittedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([goalId, quarter, cycleId, employeeId])
  @@index([employeeId, cycleId])
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

// ─── AUDIT TRAIL ─────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  goalId      String?
  goal        Goal?       @relation(fields: [goalId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  hash          String    @unique  // SHA-256(payload + previousHash) — tamper-evident chain
  previousHash  String?            // null only for the genesis entry
  createdAt     DateTime  @default(now())

  @@index([goalId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([createdAt, id])    // writeAudit findFirst: ORDER BY createdAt DESC, id DESC
}

enum AuditAction {
  GOAL_CREATED
  GOAL_SUBMITTED
  GOAL_APPROVED
  GOAL_REJECTED
  GOAL_RETURNED
  GOAL_LOCKED
  GOAL_UNLOCKED
  GOAL_CANCELLED
  TARGET_EDITED
  WEIGHTAGE_EDITED
  CHECKIN_SUBMITTED
  CHECKIN_MANAGER_REVIEWED
  USER_CREATED
  USER_ROLE_CHANGED
  CYCLE_CREATED
  CYCLE_ACTIVATED
  ESCALATION_SENT
  EXPORT_GENERATED
  SHARED_GOAL_ASSIGNED
  GOAL_COMMENT_ADDED
  TEMPLATE_USED
  CYCLE_CLONED
  GOALS_AUTO_LOCKED
  FEEDBACK_SUBMITTED
  REVIEW_SUBMITTED
  ENPS_SUBMITTED
  MEETING_CREATED
}

// ─── NOTIFICATIONS ───────────────────────────────────────────

model Notification {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        NotificationType
  title       String
  message     String
  link        String?
  read        Boolean             @default(false)
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId, read])
}

enum NotificationType {
  GOAL_SUBMITTED_FOR_APPROVAL
  GOAL_APPROVED
  GOAL_REJECTED
  GOAL_RETURNED
  GOAL_CANCELLED
  CHECKIN_WINDOW_OPEN
  CHECKIN_REMINDER
  CHECKIN_OVERDUE
  ESCALATION_TRIGGERED
  MANAGER_CHECKIN_COMPLETE
  CYCLE_STARTED
  GOAL_SHARED_WITH_YOU
  GOAL_COMMENT_FROM_MANAGER
  GOAL_COMMENT_FROM_EMPLOYEE
  FEEDBACK_REQUEST_RECEIVED
  FEEDBACK_SUBMITTED
  REVIEW_CYCLE_STARTED
  MEETING_SCHEDULED
  ENPS_SURVEY_AVAILABLE
}

// ─── ESCALATION ──────────────────────────────────────────────

model EscalationRule {
  id                String              @id @default(cuid())
  cycleId           String
  cycle             Cycle               @relation(fields: [cycleId], references: [id])
  trigger           EscalationTrigger
  daysAfterTrigger  Int
  escalateTo        EscalateeTo
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
}

enum EscalationTrigger {
  GOAL_NOT_SUBMITTED
  GOAL_NOT_APPROVED
  CHECKIN_NOT_COMPLETED
}

enum EscalateeTo {
  EMPLOYEE
  MANAGER
  SKIP_LEVEL
  HR
}

model EscalationLog {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  trigger       EscalationTrigger
  escalatedTo   String
  emailSent     Boolean             @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
}

// ─── THRUST AREAS (Admin Configurable) ───────────────────────

model ThrustArea {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ─── GOAL TEMPLATES ──────────────────────────────────────────

model GoalTemplate {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  thrustArea         String
  uomType            UoMType
  uomUnit            String?
  suggestedTarget    Float?
  suggestedWeightage Float     @default(20)
  isActive           Boolean   @default(true)
  usageCount         Int       @default(0) // incremented each time an employee picks this template
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([thrustArea])
}

// ─── GOAL COMMENTS (pre/post approval discussion) ────────────

model GoalComment {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  isInternal Boolean @default(false) // true = manager-only note, not shown to employee
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

// ─── MILESTONES (sub-tasks within a goal) ────────────────────

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([goalId])
}

// ─── PEER FEEDBACK (360° + ad-hoc) ───────────────────────────

model PeerFeedback {
  id          String         @id @default(cuid())
  giverId     String
  giver       User           @relation("FeedbackGiver", fields: [giverId], references: [id])
  receiverId  String
  receiver    User           @relation("FeedbackReceiver", fields: [receiverId], references: [id])
  type        FeedbackType   @default(PEER)
  status      FeedbackStatus @default(PENDING)
  message     String?
  answers     Json           @default("[]") // [{question: string, answer: string, rating?: number}]
  isAnonymous Boolean        @default(false)
  reviewCycleId String?
  reviewCycle   ReviewCycle? @relation(fields: [reviewCycleId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([receiverId])
  @@index([giverId])
  @@index([reviewCycleId])
}

enum FeedbackType {
  PEER
  UPWARD
  SELF
  MANAGER
}

enum FeedbackStatus {
  PENDING
  COMPLETED
  DECLINED
}

// ─── FORMAL REVIEW CYCLES ────────────────────────────────────

model ReviewCycle {
  id             String        @id @default(cuid())
  name           String
  cadence        ReviewCadence @default(ANNUAL)
  status         ReviewStatus  @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  departments    String[]
  includeSelf    Boolean       @default(true)
  includePeer    Boolean       @default(false)
  includeManager Boolean       @default(true)
  includeSkip    Boolean       @default(false)
  includeUpward  Boolean       @default(false)
  createdById    String
  questions      ReviewQuestion[]
  responses      ReviewResponse[]
  feedbacks      PeerFeedback[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum ReviewCadence {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  CUSTOM
}

enum ReviewStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ReviewQuestion {
  id            String       @id @default(cuid())
  reviewCycleId String
  reviewCycle   ReviewCycle  @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  text          String
  type          QuestionType @default(TEXT)
  ratingLabels  String[]
  required      Boolean      @default(true)
  order         Int          @default(0)

  @@index([reviewCycleId])
}

enum QuestionType {
  TEXT
  RATING
  YES_NO
}

model ReviewResponse {
  id            String      @id @default(cuid())
  reviewCycleId String
  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id])
  reviewerId    String
  reviewer      User        @relation("ReviewResponder", fields: [reviewerId], references: [id])
  subjectId     String
  subject       User        @relation("ReviewSubject", fields: [subjectId], references: [id])
  feedbackType  FeedbackType
  answers       Json        @default("[]")
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([reviewCycleId, reviewerId, subjectId, feedbackType])
  @@index([reviewCycleId])
  @@index([subjectId])
}

// ─── eNPS SURVEY ─────────────────────────────────────────────

model ENPSSurvey {
  id        String        @id @default(cuid())
  name      String
  status    SurveyStatus  @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  responses ENPSResponse[]
  createdAt DateTime      @default(now())
}

enum SurveyStatus {
  ACTIVE
  CLOSED
}

model ENPSResponse {
  id          String     @id @default(cuid())
  surveyId    String
  survey      ENPSSurvey @relation(fields: [surveyId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  score       Int        // 0-10
  comment     String?
  submittedAt DateTime   @default(now())

  @@unique([surveyId, userId])
  @@index([surveyId])
}

// ─── 1:1 MEETINGS ────────────────────────────────────────────

model OneOnOneMeeting {
  id          String              @id @default(cuid())
  managerId   String
  manager     User                @relation("MeetingManager", fields: [managerId], references: [id])
  employeeId  String
  employee    User                @relation("MeetingEmployee", fields: [employeeId], references: [id])
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  agendaItems MeetingAgendaItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([managerId])
  @@index([employeeId])
}

model MeetingAgendaItem {
  id        String          @id @default(cuid())
  meetingId String
  meeting   OneOnOneMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  goalId    String?
  addedBy   String
  done      Boolean         @default(false)
  order     Int             @default(0)

  @@index([meetingId])
}

// ─── SCHEDULED REPORTS ───────────────────────────────────────

model ScheduledReport {
  id          String   @id @default(cuid())
  name        String
  columns     String[] // selected field keys
  filters     Json     @default("{}") // {cycleId?, department?, status?}
  schedule    String   // cron expression: "0 9 * * 1" = Mon 9AM
  recipients  String[] // email addresses
  format      String   @default("excel") // "excel" | "csv"
  lastSentAt  DateTime?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
